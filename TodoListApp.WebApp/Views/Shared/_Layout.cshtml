<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - To-Do List</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TodoListApp.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // The menu is shown only to a signed-in user (Epic 7).
        var isSignedIn = User.Identity?.IsAuthenticated == true;

        // US30: the menu item of the current page is highlighted.
        var currentController = ViewContext.RouteData.Values["controller"] as string;
        var currentAction = ViewContext.RouteData.Values["action"] as string;
        var isTaskController = currentController == "Task";
        var isAssignedPage = isTaskController && currentAction == "Assigned";
        var isSearchPage = isTaskController && currentAction == "Search";
        var isTagsPage = currentController == "Tag";

        // The pages of a to-do list, its tasks and their comments belong to the "My lists" section.
        var isListsPage = currentController is "TodoList" or "Comment" || (isTaskController && !isAssignedPage && !isSearchPage);

        // Renders a menu item; the current one gets aria-current="page" for screen readers.
        async Task MenuItem(string controller, string action, string text, bool isActive)
        {
            <li class="nav-item">
                @if (isActive)
                {
                    <a class="nav-link active" aria-current="page" asp-area="" asp-controller="@controller" asp-action="@action">@text</a>
                }
                else
                {
                    <a class="nav-link" asp-area="" asp-controller="@controller" asp-action="@action">@text</a>
                }
            </li>
        }
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Main menu">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true">&#10003;</span> To-Do List
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (isSignedIn)
                    {
                    <ul class="navbar-nav app-menu flex-grow-1">
                        @{
                            await MenuItem("TodoList", "Index", "My lists", isListsPage);
                            await MenuItem("Task", "Assigned", "Assigned to me", isAssignedPage);
                            await MenuItem("Task", "Search", "Search", isSearchPage);
                            await MenuItem("Tag", "Index", "Tags", isTagsPage);
                        }
                    </ul>
                    <form class="navbar-search" asp-area="" asp-controller="Task" asp-action="Search" method="get" role="search">
                        <input type="search" name="title" class="form-control form-control-sm" placeholder="Search tasks..." aria-label="Search tasks by title" />
                    </form>

                    @* US28: the signed-in user's email and the sign-out button. *@
                    <div class="user-menu">
                        <span class="user-email" title="Signed in as @User.Identity!.Name">@User.Identity!.Name</span>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                        </form>
                    </div>
                    }
                    else
                    {
                    @* US26, US27: an unauthorized user can only sign in or sign up. *@
                    <div class="user-menu ms-auto">
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">Sign in</a>
                        <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary">Sign up</a>
                    </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - To-Do List - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
