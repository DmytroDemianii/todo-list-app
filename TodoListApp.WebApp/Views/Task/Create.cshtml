@model TaskViewModel
@{
    ViewData["Title"] = "New task";
}

<h1>New task</h1>
<form asp-action="Create" method="post">
    <partial name="_TaskForm" />
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" asp-route-todoListId="@Model.TodoListId" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
