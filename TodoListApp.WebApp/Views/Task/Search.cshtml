@model TaskSearchViewModel
@{
    ViewData["Title"] = "Search tasks";
    var culture = System.Globalization.CultureInfo.InvariantCulture;
    var createdDate = Model.CreatedDate?.ToString("yyyy-MM-dd", culture);
    var dueDate = Model.DueDate?.ToString("yyyy-MM-dd", culture);
}

<div class="page-header">
    <h1>Search tasks</h1>
</div>

<form asp-action="Search" method="get" class="search-form">
    <div class="search-field search-field-wide">
        <label for="Title" asp-for="Title" class="form-label">Title contains</label>
        <input asp-for="Title" class="form-control" placeholder="e.g. report" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="search-field">
        <label for="CreatedDate" asp-for="CreatedDate" class="form-label"></label>
        <input asp-for="CreatedDate" class="form-control" />
    </div>
    <div class="search-field">
        <label for="DueDate" asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" class="form-control" />
    </div>
    <div class="search-actions">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Search" class="btn btn-link">Clear</a>
    </div>
</form>

@if (!Model.HasCriteria)
{
    <p class="empty-state">Enter a part of the title, a creation date or a due date to find tasks.</p>
}
else if (Model.Tasks.Count == 0)
{
    <p class="empty-state">No tasks match your search.</p>
}
else
{
    <ul class="task-list">
        @foreach (var task in Model.Tasks)
        {
            @* US16: overdue tasks are highlighted with a red border and an "Overdue" badge. *@
            <li class="task-row @(task.IsOverdue ? "task-overdue" : null)">
                <div class="task-main">
                    <a asp-action="Details" asp-route-id="@task.Id" class="task-title">@task.Title</a>
                    <div class="task-meta">
                        <span class="status-badge @task.Status.ToCssClass()">@task.Status.ToDisplayName()</span>
                        <span>Created @task.CreatedDate.ToString("d MMM yyyy", culture)</span>
                        @if (task.DueDate.HasValue)
                        {
                            <span>Due @task.DueDate.Value.ToString("d MMM yyyy", culture)</span>
                        }
                        @if (task.IsOverdue)
                        {
                            <span class="overdue-badge">Overdue</span>
                        }
                    </div>
                </div>
                <div class="card-actions">
                    <a asp-action="Index" asp-route-todoListId="@task.TodoListId">Open list</a>
                </div>
            </li>
        }
    </ul>
}

<nav class="pager" aria-label="Pages">
    @if (Model.PageNumber > 1)
    {
        <a asp-action="Search" asp-route-title="@Model.Title" asp-route-createdDate="@createdDate" asp-route-dueDate="@dueDate"
           asp-route-pageNumber="@(Model.PageNumber - 1)">&larr; Previous</a>
    }
    @if (Model.HasNextPage)
    {
        <a asp-action="Search" asp-route-title="@Model.Title" asp-route-createdDate="@createdDate" asp-route-dueDate="@dueDate"
           asp-route-pageNumber="@(Model.PageNumber + 1)">Next &rarr;</a>
    }
</nav>
