@{
    ViewData["Title"] = "Check your email";
    var developmentResetLink = TempData[TodoListApp.WebApp.Controllers.AccountController.DevelopmentResetLinkKey] as string;
}

<div class="auth-card">
    <h1>Check your email</h1>
    <p class="auth-subtitle">If an account with this email exists, we have sent it instructions to reset the password.</p>

    @if (developmentResetLink is not null)
    {
        @* Only in the Development environment: no real emails are sent, so the link is shown here. *@
        <div class="alert alert-info">
            <strong>Development mode:</strong> emails are written to the application log instead of being sent.
            <a href="@developmentResetLink">Open the password reset link</a>.
        </div>
    }

    <p class="auth-footer"><a asp-action="Login">&larr; Back to sign in</a></p>
</div>
