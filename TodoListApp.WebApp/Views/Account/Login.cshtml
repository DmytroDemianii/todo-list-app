@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <h1>Sign in</h1>
    <p class="auth-subtitle">Welcome back! Sign in to manage your to-do lists.</p>

    <form asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label for="Email" asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="Password" asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="auth-row mb-3">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label for="RememberMe" asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <a asp-action="ForgotPassword">Forgot your password?</a>
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign in</button>
    </form>

    <p class="auth-footer">Don't have an account? <a asp-action="Register">Sign up</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
