@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-card">
    <h1>Create an account</h1>
    <p class="auth-subtitle">Sign up to start planning your work in to-do lists.</p>

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label for="Email" asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="Password" asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text">At least 6 characters, with an uppercase letter, a lowercase letter and a digit.</div>
        </div>
        <div class="mb-3">
            <label for="ConfirmPassword" asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Sign up</button>
    </form>

    <p class="auth-footer">Already have an account? <a asp-action="Login">Sign in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
