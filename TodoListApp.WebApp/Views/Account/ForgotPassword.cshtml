@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <h1>Forgot your password?</h1>
    <p class="auth-subtitle">Enter the email you signed up with, and we will send you instructions to set a new password.</p>

    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label for="Email" asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Send instructions</button>
    </form>

    <p class="auth-footer"><a asp-action="Login">&larr; Back to sign in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
