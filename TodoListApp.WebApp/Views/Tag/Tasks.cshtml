@model TaggedTaskListViewModel
@{
    ViewData["Title"] = "#" + Model.TagName;
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<a asp-action="Index" class="back-link">&larr; All tags</a>

<div class="page-header">
    <h1>Tasks tagged <span class="tag-chip tag-chip-large">#@Model.TagName</span></h1>
</div>

@if (Model.Tasks.Count == 0)
{
    <p class="empty-state">No tasks are tagged with this tag.</p>
}
else
{
    <ul class="task-list">
        @foreach (var task in Model.Tasks)
        {
            <li class="task-row @(task.IsOverdue ? "task-overdue" : null)">
                <div class="task-main">
                    <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="task-title">@task.Title</a>
                    <div class="task-meta">
                        <span class="status-badge @task.Status.ToCssClass()">@task.Status.ToDisplayName()</span>
                        @if (task.DueDate.HasValue)
                        {
                            <span>Due @task.DueDate.Value.ToString("d MMM yyyy", culture)</span>
                        }
                        @if (task.IsOverdue)
                        {
                            <span class="overdue-badge">Overdue</span>
                        }
                        @foreach (var tag in task.Tags.Where(x => !string.Equals(x, Model.TagName, StringComparison.OrdinalIgnoreCase)))
                        {
                            <a asp-action="Tasks" asp-route-name="@tag" class="tag-chip">#@tag</a>
                        }
                    </div>
                </div>
                <div class="card-actions">
                    <a asp-controller="Task" asp-action="Index" asp-route-todoListId="@task.TodoListId">Open list</a>
                </div>
            </li>
        }
    </ul>
}

<nav class="pager" aria-label="Pages">
    @if (Model.PageNumber > 1)
    {
        <a asp-action="Tasks" asp-route-name="@Model.TagName" asp-route-pageNumber="@(Model.PageNumber - 1)">&larr; Previous</a>
    }
    @if (Model.HasNextPage)
    {
        <a asp-action="Tasks" asp-route-name="@Model.TagName" asp-route-pageNumber="@(Model.PageNumber + 1)">Next &rarr;</a>
    }
</nav>
