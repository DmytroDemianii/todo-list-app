{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "WebApi": {
    "BaseUrl": "https://localhost:7292/",
    "Issuer": "TodoListApp.WebApp",
    "Audience": "TodoListApp.WebApi",
    "TokenLifetimeMinutes": 5
  },

  "ConnectionStrings": {
    "UsersDb": "Server=(localdb)\\MSSQLLocalDB;Database=UsersDb;Trusted_Connection=True;MultipleActiveResultSets=true;Connect Timeout=60"
  },

  "AllowedHosts": "*"
}
